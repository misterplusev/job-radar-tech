# Copy to .env and fill. .env is gitignored.

# --- Storage ---
# If SUPABASE_URL is set, Supabase is used; otherwise a local SQLite file is used.
# Tech module writes ONLY tech_* tables (independent namespace).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Management API (used by db/apply_schema.py in the workflow)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SQLITE_PATH=data/local/jobradar.sqlite

# --- Matcher brain ---
# If ANTHROPIC_API_KEY is set, the Claude judge is used; otherwise the heuristic scorer runs (free).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
MATCH_MONTHLY_USD_CEILING=30

# --- Alerts ---
DISCORD_JOB_RADAR_WEBHOOK=
# Tech publisher webhook -> #tech-jobs (new-job alerts + failure alerts)
DISCORD_WEBHOOK_JOBS=

# --- Candidate profile ---
MATRIX_PATH=D:/Job_Applications_MASTER/Skills_Matrix/SKILLS_MATRIX_Christopher_Layman_20260707.md

# --- Tuning ---
ALERT_MIN_SCORE=75
GENERATED_DOCS_DIR=D:/Job_Applications_MASTER/Generated
